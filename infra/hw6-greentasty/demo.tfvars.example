# Measured on 2026-10-29: Lambda regional concurrency quota is only 5.
# AWS requires 100 unreserved executions before any reservation is allocated.
# This reviewed demo variant shares the existing regional pool; no quota changes.
# Use -var-file=demo.tfvars.example for planning. Never pass null via numeric -var.
reserved_concurrency = null

# User-selected production origin; project name is not yet reserved in Cloudflare.
# Confirm it before any final plan/apply. This is not a deployed frontend URL.
frontend_origin = "https://greentasty-epam-impoil.pages.dev"
