# Copy to ignored .env. Real environment variables win. No shared credentials or endpoints.
UI_URL=
API_URL=
TESTTABLE_ID=
OWNER_USERNAME=
OWNER_PASSWORD=
OTHER_USERNAME=
OTHER_PASSWORD=
WAITER_USERNAME=
WAITER_PASSWORD=
HEADLESS=true
MAX_PARALLEL_TESTS=1
TRACE_MODE=OnFailureOnly
DEFAULT_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
# Business writes are CODE-SUSPENDED; these flags cannot override the temporary stop.
AQA_ALLOW_WRITES=false
AQA_RETAIN_TEST_DATA=false
# Explicit fail-closed cap for a future approved run; only 0..4 parse, 35 is rejected.
AQA_MAX_RESERVATIONS=0
# Only for a deployment that actually exposes DELETE /reservations.
AQA_CANCEL_RESERVATIONS=false
# Optional installed browser channel, e.g. chrome.
PLAYWRIGHT_CHANNEL=
# Optional freshly verified public DNS answer. Process-local; TLS remains enabled.
AQA_UI_DNS_ADDRESS=
# Optional readonly diagnostic; excluded from the hw8 filter.
AQA_READONLY_MANIFEST=
